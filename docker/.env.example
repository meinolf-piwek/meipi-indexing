# Copy to docker/.env and adjust before: docker compose --env-file docker/.env up

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

IND_PG_SCHEMA=meipi-indexing

# Existing datapool (create beforehand with meipi-index create-pool)
IND_WATCH_POOL_ID=1

# Must match the pool's rootpath in the database
IND_WATCH_POOL_ROOTPATH=/data
IND_WATCH_PATH=.
IND_WATCH_DEBOUNCE=1.0
IND_WATCH_NO_THUMBS=0

# Host path bind-mounted to IND_WATCH_POOL_ROOTPATH in the container
HOST_DATA_DIR=../data

# Copy to docker/.env and adjust before: docker compose --env-file docker/.env up

# External PostgreSQL (container pg-db on network postgresql_default)
IND_PG_HOST=pg-db
IND_PG_PORT=5432
IND_PG_USER=postgres
IND_PG_PASSWD=postgres
IND_PG_DATABASE=postgres
IND_PG_SCHEMA=meipi-indexing

# Filesystem root inside the container (bind-mount target)
IND_DOCROOT=/data

# Existing datapool (create beforehand with meipi-index create-pool)
IND_WATCH_POOL_ID=1

IND_WATCH_PATH=.
IND_WATCH_DEBOUNCE=1.0
IND_WATCH_NO_THUMBS=0

# Host path bind-mounted to IND_DOCROOT in the container
HOST_DATA_DIR=../data

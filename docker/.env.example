# Copy to docker/.env and adjust before: docker compose --env-file docker/.env up

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

IND_PG_SCHEMA=meipi-indexing

# Datapool: mount host directory to /data and use the same path as rootpath
MEIPI_POOL_NAME=default
MEIPI_POOL_ROOTPATH=/data
MEIPI_WATCH_PATH=.
MEIPI_ENSURE_TABLES=1
MEIPI_INITIAL_SCAN=1
MEIPI_DEBOUNCE=1.0
MEIPI_NO_THUMBS=1

# Host path to index (bind-mounted into the watcher container)
HOST_DATA_DIR=../data

# Copy to docker/.env and adjust before: docker compose --env-file docker/.env up

# External PostgreSQL (container pg-db on network postgresql_default)
IND_PG_HOST=pg-db
IND_PG_PORT=5432
IND_PG_USER=postgres
IND_PG_PASSWD=postgres
IND_PG_DATABASE=postgres
IND_PG_SCHEMA=meipi-indexing

# Watcher pool 1 (service: watcher-1); container docroot is always /data
IND_WATCH_POOL_ID=1
IND_WATCH_PATH=.
IND_WATCH_DEBOUNCE=1.0
IND_WATCH_NO_THUMBS=0
HOST_DATA_DIR=../data

# Watcher pool 2 (service: watcher-2)
IND_WATCH_POOL_ID_2=2
IND_WATCH_PATH_2=.
# HOST_DATA_DIR_2=../data
# IND_WATCH_DEBOUNCE_2=1.0
# IND_WATCH_NO_THUMBS_2=0

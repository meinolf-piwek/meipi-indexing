# Default configuration inside the Docker container.
# Override via environment variables (IND_* prefix) or docker-compose env_file.

IND_PG_HOST=pg-db
IND_PG_PORT=5432
IND_PG_USER=postgres
IND_PG_PASSWD=postgres
IND_PG_DATABASE=postgres
IND_PG_SCHEMA=meipi-indexing
IND_DOCROOT=/data
IND_TIKA_NOOCR_URL=http://tika:9998
IND_LOGLEVEL=20
